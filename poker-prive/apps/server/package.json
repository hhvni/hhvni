{
  "name": "@poker/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore '../web/**' src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "loadtest": "tsx test/loadtest.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@poker/engine": "1.0.0",
    "@prisma/client": "6.19.3",
    "cookie": "1.0.2",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "next": "15.5.29",
    "pino": "9.7.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "socket.io": "4.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "pino-pretty": "13.0.0",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
