# Copier en .env puis adapter
DATABASE_URL="postgresql://poker:poker@localhost:5432/poker?schema=public"
PORT=3000
# URL publique du site (utilisée pour les liens d'invitation et la vérification d'origine)
PUBLIC_URL="http://localhost:3000"
# Adresses e-mail promues administrateur du site à l'inscription (séparées par des virgules)
ADMIN_EMAILS=""
# Solde de jetons virtuels attribué à l'inscription
STARTING_BANKROLL=100000
# WebRTC : serveurs STUN (séparés par des virgules)
STUN_URLS="stun:stun.l.google.com:19302"
# WebRTC : TURN (coturn avec use-auth-secret). Laisser vide pour désactiver.
TURN_URLS=""
TURN_SECRET=""
# … ou identifiants fixes d'un service TURN hébergé (Metered, Cloudflare…)
TURN_USERNAME=""
TURN_CREDENTIAL=""
# Dossier de stockage des avatars
UPLOAD_DIR="./uploads"
LOG_LEVEL="info"
